// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "EmptyPane",
    "bindings": {
      "space space": "file_finder::Toggle",
      "space /": "pane::DeploySearch",
      "space ,": "tab_switcher::ToggleAll"
    }
  },
  {
    "context": "Picker > Editor",
    "bindings": {
      "ctrl-j": "menu::SelectNext",
      "ctrl-k": "menu::SelectPrevious"
    }
  },
  {
    "context": "vim_mode == normal && !Menu && !Terminal && !AcpThread",
    "bindings": {
      "space space": "file_finder::Toggle",
      "space /": "text_finder::Toggle",
      "space e": "workspace::ToggleLeftDock",
      "space r": "workspace::ToggleRightDock",
      "space ,": "tab_switcher::ToggleAll",
      "space o": "outline::Toggle",
      "space b d": "pane::CloseActiveItem",
      "space b n": "pane::ActivateNextItem",
      "space b p": "pane::ActivatePreviousItem",
      "space b o": "pane::CloseOtherItems",
      "space b a": "pane::CloseAllItems",
      "space w s": "pane::SplitDown",
      "space w v": "pane::SplitRight",
      "space w d": "pane::CloseAllItems",
      "shift-l": "pane::ActivateNextItem",
      "shift-h": "pane::ActivatePreviousItem",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-j": "workspace::ActivatePaneUp",
      "ctrl-k": "workspace::ActivatePaneDown",
      "ctrl-/": "workspace::NewTerminal",
    },
  },
  {
    "context": "Dock && !Terminal && !AcpThread",
    "bindings": {
      "space space": "file_finder::Toggle",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
    },
  },
  {
    "context": "ProjectPanel && !Editor",
    "bindings": {
      "a": "project_panel::NewFile",
      "d": "project_panel::Delete",
      "r": "project_panel::Rename",
      "o": "project_panel::RevealInFileManager",
      "c": "project_panel::Duplicate",
    }
  }
]
